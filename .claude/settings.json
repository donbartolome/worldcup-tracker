{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-tests-before-commit.sh",
            "args": [],
            "timeout": 120,
            "statusMessage": "Checking tests before commit"
          }
        ]
      }
    ]
  }
}
